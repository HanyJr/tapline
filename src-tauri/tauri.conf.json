{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tapline",
  "version": "1.0.0",
  "identifier": "space.iantbc.tapline",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tapline",
        "width": 420,
        "height": 640,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "alwaysOnTop": true,
        "center": true,
        "backgroundColor": "#0a1422"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "category": "Productivity",
    "shortDescription": "Repeat a click and Enter, as many times as you need",
    "longDescription": "Tapline clicks a spot you choose, presses Enter, waits, and repeats as many times as you set. Start and stop with one key.",
    "copyright": "Copyright 2026 Ian Brown",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
