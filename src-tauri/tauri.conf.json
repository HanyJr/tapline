{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tapline",
  "version": "1.2.0",
  "identifier": "space.iantbc.tapline",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tapline",
        "width": 440,
        "height": 720,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "alwaysOnTop": true,
        "center": true,
        "backgroundColor": "#0a1422",
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "Repeat a click and Enter, as many times as you need",
    "longDescription": "Tapline runs a sequence of clicks and keys, repeats it as many times as you set, and can start on its own when a button on screen changes color.",
    "copyright": "Copyright 2026 HanyJr",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}